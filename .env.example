# ---- Supabase (client) ----
# After `npm run db:start`, the CLI prints these. For a hosted project, copy from
# Supabase dashboard -> Project Settings -> API.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=paste-anon-key-here

# ---- AI service (server-side only, never exposed to the browser) ----
# The app runs fine with BOTH of these unset: summaries degrade to
# "summary unavailable" and the safety check falls back to rules-only.
AI_PROVIDER=groq          # groq | gemini
GROQ_API_KEY=
GEMINI_API_KEY=

# Port for the thin AI server function
API_PORT=8787
